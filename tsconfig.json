{
  "compilerOptions": {
    "target": "es2025",
    "module": "esnext",
    "moduleResolution": "bundler",

    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
